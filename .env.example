# Local-only example. Change secrets for any shared deployment.
NODE_ENV=development
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_FOR_REAL_DEPLOYMENTS
JWT_ACCESS_TTL=15m
JWT_REFRESH_DAYS=7
POSTGRES_ADMIN_URL=postgresql://smart:smart_dev@localhost:5432/postgres
AUTH_DATABASE_URL=postgresql://smart:smart_dev@localhost:5432/smart_auth
CATALOG_DATABASE_URL=postgresql://smart:smart_dev@localhost:5432/smart_catalog
INVENTORY_DATABASE_URL=postgresql://smart:smart_dev@localhost:5432/smart_inventory
NOTIFICATION_DATABASE_URL=postgresql://smart:smart_dev@localhost:5432/smart_notifications
REPORTING_DATABASE_URL=postgresql://smart:smart_dev@localhost:5432/smart_reporting
REDIS_URL=redis://localhost:6379
GATEWAY_URL=http://localhost:4000
AUTH_URL=http://localhost:4001
CATALOG_URL=http://localhost:4002
INVENTORY_URL=http://localhost:4003
NOTIFICATION_URL=http://localhost:4004
REPORTING_URL=http://localhost:4005
FRONTEND_ORIGIN=http://localhost:5173
# Initial admin is added ONLY by npm run db:seed
ADMIN_EMAIL=admin@smartinventory.local
ADMIN_PASSWORD=ChangeThisBeforeUsing123!
